{
  "name": "mcp-contract",
  "version": "0.1.0",
  "description": "Contract testing for Model Context Protocol servers: snapshot tools, resources and prompts, and classify schema changes as breaking or not.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "contract-testing",
    "json-schema",
    "breaking-changes",
    "cli"
  ],
  "homepage": "https://github.com/aozmekik/mcp-contract#readme",
  "bugs": "https://github.com/aozmekik/mcp-contract/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aozmekik/mcp-contract.git"
  },
  "license": "MIT",
  "author": "Ahmed Semih Özmekik (https://github.com/aozmekik)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-contract": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "examples": "node scripts/run-examples.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run coverage && npm run build && npm run examples",
    "bench": "node scripts/bench.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
